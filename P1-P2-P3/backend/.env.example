# ── 서버 ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── DB (로컬 개발: sqlite, Docker: mysql) ──
DB_TYPE=sqlite
DB_DATABASE=certificatedu.sqlite

# MySQL 사용 시 아래 값 설정 후 DB_TYPE=mysql 로 변경
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=certificatedu
# DB_PASSWORD=certificatedu_pass
# DB_DATABASE=certificatedu
# DB_SYNC=true

# ── JWT ───────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ── 이메일 (Nodemailer) ────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@example.com
MAIL_PASS=

# ── Sentry (선택) ──────────────────────
# SENTRY_DSN=https://...

# ── CORS ──────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Toss Payments ─────────────────────
# https://developers.tosspayments.com 에서 발급
TOSS_SECRET_KEY=test_sk_xxxxxx
